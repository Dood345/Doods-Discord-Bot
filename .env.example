# Copy to .env and fill in. .env is gitignored and preserved by the deploy workflow.

# --- Discord ---
DISCORD_TOKEN=
# Your Discord user ID (full access to restricted homelab commands)
OWNER_ID=
# Comma-separated Discord usernames also allowed to use homelab commands
ALLOWED_USERS=
# Comma-separated guild IDs
SERVER_ID=

# --- AI (local Ollama server) ---
OLLAMA_URL=http://localhost:11434
# Optional: path to per-guild persona file (see data/server_contexts.example.json)
# SERVER_CONTEXTS_FILE=data/server_contexts.json

# --- Image generation (ComfyUI) ---
COMFY_URL=http://localhost:8188

# --- Music ---
# MUSIC_DEFAULT_VOLUME=0.5
# MUSIC_TTS_VOICE=en-US-ChristopherNeural

# --- Homelab service IPs (pinged by /doodlab) ---
PRINTER_IP=
ROUTER_IP=
PIHOLE_IP=
DOODLAB_IP=
PLEX_IP=
# Moonraker host:port for /printer
PRINTER_HOST=

# --- Media stack (include http:// and port) ---
OVERSEERR_URL=
OVERSEERR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=
